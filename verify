#!/usr/bin/env python3
"""一次性验收脚本（acceptance service）。

依次穿插执行：
  1. 构建检查：所有源码字节码编译；
  2. 代码测试：unittest 全套；
  3. 核心场景验收：合法不存在证明通过、环绕覆盖通过、
     遗漏通配符覆盖被拒绝、非法记录被拒绝；
  4. API/HTTP 冒烟：就地拉起服务，校验健康地址、审计页面、
     提交冻结、按标识重开、标识复用冲突；
  5. 若设置 BASE_URL（Compose 中指向 web 服务），追加远端 HTTP 冒烟。

全部通过以 0 退出，任一失败以非零退出码报告。
"""

import json
import os
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

from app.nsec3 import nsec3_hash  # noqa: E402
from app.verifier import verify  # noqa: E402
from app.evidence import build_package  # noqa: E402

ZONE = "example.cn"
SALT = "-"
ITER = 0

GREEN = "\033[32m"; RED = "\033[31m"; BOLD = "\033[1m"; RESET = "\033[0m"
_failures = []


def step(no, title):
    print(f"\n{BOLD}── [{no}] {title}{RESET}", flush=True)


def ok(msg):
    print(f"{GREEN}  ✔ {msg}{RESET}", flush=True)


def bad(msg):
    print(f"{RED}  ✘ {msg}{RESET}", flush=True)
    _failures.append(msg)


def expect(cond, good, failmsg):
    (ok if cond else bad)(good if cond else failmsg)
    return cond


def build_chain(existing, zone=ZONE, salt=SALT, iter_=ITER):
    ordered = sorted(existing, key=lambda n: int(nsec3_hash(n, salt, iter_), 32))
    hashes = [nsec3_hash(n, salt, iter_) for n in ordered]
    recs = []
    for i, (name, h) in enumerate(zip(ordered, hashes)):
        recs.append({
            "owner_hash": h,
            "next_hash": hashes[(i + 1) % len(hashes)],
            "types": ["NS", "SOA", "RRSIG"] if name == zone else ["A", "RRSIG"],
        })
    return recs


DEFAULT_EXISTING = [
    "example.cn", "a.example.cn", "m.example.cn",
    "z.example.cn", "x.y.example.cn",
]

# 多目标共享证据包验收固定目标：
#   PKG_T_DEEP=p.x.y.example.cn  最优子集 {R3,R5}（CE=apex）
#   PKG_T_XY  =g.x.y.example.cn  单独最优需 {R1,R5}（CE=x.y），但 R1 会使
#                               PKG_T_DEEP 的 CE 下移、新 NC 失去覆盖
PKG_T_DEEP = "p.x.y.example.cn"
PKG_T_XY = "g.x.y.example.cn"
PKG_XY_NAME = "x.y.example.cn"


def codes(result):
    return {e["code"] for e in result["errors"]}


# ── 1. 构建检查 ──────────────────────────────────────────────
def check_build():
    step(1, "构建检查：字节码编译 app/ 与 tests/")
    proc = subprocess.run(
        [sys.executable, "-m", "compileall", "-q", "app", "tests"],
        cwd=ROOT,
    )
    expect(proc.returncode == 0, "全部模块编译通过", "存在编译失败的模块")


# ── 2. 代码测试 ──────────────────────────────────────────────
def check_unittests():
    step(2, "代码测试：unittest 全套")
    proc = subprocess.run(
        [sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v"],
        cwd=ROOT,
    )
    expect(proc.returncode == 0, "单元/集成/API 测试全部通过", "单元测试存在失败")


# ── 3. 核心验收场景 ──────────────────────────────────────────
def check_scenarios():
    step(3, "核心场景：合法证明 / 环绕覆盖 / 遗漏通配符 / 非法记录")
    recs = build_chain(DEFAULT_EXISTING)

    r = verify({"audit_id": "ACC-1", "zone": ZONE, "target": "q.example.cn",
                "salt": SALT, "iterations": ITER, "records": recs})
    expect(
        r["verdict"] == "passed",
        "合法 NXDOMAIN 证明（单层缺失，NC+通配符均被覆盖）通过",
        f"合法证明被错误拒绝：{codes(r)}",
    )

    r = verify({"audit_id": "ACC-2", "zone": ZONE, "target": "p.x.y.example.cn",
                "salt": SALT, "iterations": ITER, "records": recs})
    wrap = [x for x in r["records"]
            if x["covers_wildcard"] and x["wrap_direction"] == "wrap"]
    expect(
        r["verdict"] == "passed" and wrap,
        "环绕区间覆盖通配符的证明通过，并标记 wrap 方向",
        f"环绕覆盖证明异常：verdict={r['verdict']}, wrap={wrap}",
    )

    r3 = next(x for x in recs
              if x["owner_hash"] == nsec3_hash("m.example.cn", SALT, ITER))
    truncated = [x for x in recs if x is not r3]
    r = verify({"audit_id": "ACC-3", "zone": ZONE, "target": "q.example.cn",
                "salt": SALT, "iterations": ITER, "records": truncated})
    expect(
        r["verdict"] == "rejected" and "NO_WILDCARD_COVERAGE" in codes(r),
        "遗漏通配符覆盖的截断证据被拒绝",
        f"遗漏通配符覆盖未被拒绝：verdict={r['verdict']}",
    )

    illegal = [dict(recs[0], owner_hash="wxyz!not-base32hex")] + recs[1:]
    r = verify({"audit_id": "ACC-4", "zone": ZONE, "target": "q.example.cn",
                "salt": SALT, "iterations": ITER, "records": illegal})
    expect(
        r["verdict"] == "rejected" and "BAD_OWNER_HASH" in codes(r),
        "含非法 Base32hex owner 的记录被拒绝",
        f"非法记录未被拒绝：verdict={r['verdict']}",
    )

    # 附加关键拒绝面：Opt-Out、重复 owner、标识/载荷校验
    optout = [dict(recs[0], opt_out=True)] + recs[1:]
    r = verify({"audit_id": "ACC-5", "zone": ZONE, "target": "q.example.cn",
                "salt": SALT, "iterations": ITER, "records": optout})
    expect(r["verdict"] == "rejected", "Opt-Out 记录被拒绝", "Opt-Out 未被拒绝")

    dup = [dict(recs[0])] + recs
    r = verify({"audit_id": "ACC-6", "zone": ZONE, "target": "q.example.cn",
                "salt": SALT, "iterations": ITER, "records": dup})
    expect(r["verdict"] == "rejected", "重复 owner 被拒绝", "重复 owner 未被拒绝")


# ── 3b. 多目标共享证据包 ─────────────────────────────────────
def check_packages():
    step("3b", "多目标共享证据包：共享减少总数 / 加一条记录 CE 下移失效 / 拒绝面 / 原审计不变")
    recs = build_chain(DEFAULT_EXISTING)
    src = verify({"audit_id": "ACC-SRC", "zone": ZONE, "target": "q.example.cn",
                  "salt": SALT, "iterations": ITER, "records": recs})
    expect(src["verdict"] == "passed", "来源审计为已通过冻结结论",
           f"来源审计未通过：{codes(src)}")
    src["_fingerprint"] = "fp-acc-src"
    src["_frozen_at"] = "2026-10-01T00:00:00Z"

    doc = build_package("ACC-PKG", [PKG_T_DEEP, PKG_T_XY], src)
    sel_refs = [x["ref"] for x in doc["selected_records"]]
    expect(
        doc["verdict"] == "passed" and len(sel_refs) == 2,
        f"共同子集仅 {len(sel_refs)} 条记录且全部目标通过：{sel_refs}",
        f"证据包异常：verdict={doc['verdict']} refs={sel_refs} errors={doc['errors']}",
    )

    # 各目标各自一条证明的“朴素拼接”并集
    def minimal_refs(target):
        import itertools
        for k in range(1, len(recs) + 1):
            for comb in itertools.combinations(range(len(recs)), k):
                sub = [recs[i] for i in comb]
                r = verify({"audit_id": "x", "zone": ZONE, "target": target,
                            "salt": SALT, "iterations": ITER, "records": sub})
                if r["verdict"] == "passed":
                    return {f"R{i + 1}" for i in comb}
        return set()

    stitched = minimal_refs(PKG_T_DEEP) | minimal_refs(PKG_T_XY)
    expect(
        len(sel_refs) < len(stitched),
        f"共享记录使总数减少：共同子集 {len(sel_refs)} 条 < 朴素拼接并集 {len(stitched)} 条 {sorted(stitched)}",
        f"共享未减少总数：{sel_refs} vs {sorted(stitched)}",
    )

    # 增加一条记录（x.y 的 owner）即改变最近存在祖先而使候选失效
    sub_recs = [recs[int(ref[1:]) - 1] for ref in sel_refs]
    xy_rec = next(x for x in recs if x["owner_hash"] == nsec3_hash(PKG_XY_NAME, SALT, ITER))
    before = verify({"audit_id": "x", "zone": ZONE, "target": PKG_T_DEEP,
                     "salt": SALT, "iterations": ITER, "records": sub_recs})
    after = verify({"audit_id": "x", "zone": ZONE, "target": PKG_T_DEEP,
                    "salt": SALT, "iterations": ITER,
                    "records": sub_recs + [xy_rec]})
    expect(
        before["verdict"] == "passed"
        and before["closest_encloser"]["name"] == ZONE
        and after["verdict"] == "rejected"
        and after["closest_encloser"]["name"] == PKG_XY_NAME
        and "NO_NEXT_CLOSER_COVERAGE" in codes(after),
        "向候选子集加入 x.y owner 记录后 CE 下移、新 NC 失覆盖而候选失效",
        f"加记录失效场景异常：before={before['verdict']}/"
        f"{before['closest_encloser'] and before['closest_encloser']['name']}, "
        f"after={after['verdict']}/{after['closest_encloser'] and after['closest_encloser']['name']}",
    )

    # 逐目标三项角色齐备，且直接复核与证据包结论一致
    role_ok = all(
        te["verdict"] == "passed" and te["closest_encloser"]["record_ref"]
        and te["next_closer"]["covered_by"] and te["wildcard"]["covered_by"]
        for te in doc["target_evidence"]
    )
    expect(role_ok and len(doc["target_evidence"]) == 2,
           "并列展示每个目标的 CE/NC/通配符三项证明角色",
           "证据包目标角色不完整")
    recheck = verify({"audit_id": "x", "zone": ZONE, "target": PKG_T_DEEP,
                      "salt": SALT, "iterations": ITER,
                      "records": [{
                          "owner_hash": x["owner_hash"],
                          "next_hash": x["next_hash"],
                          "types": x["types"],
                      } for x in doc["selected_records"]]})
    expect(recheck["verdict"] == "passed",
           "用抽取子集直接复核目标仍通过（重算而非拼接宣称）",
           f"子集复核未通过：{codes(recheck)}")

    # 未选用记录与共享归属完整
    expect(
        len(doc["selected_records"]) + len(doc["unselected_records"])
        == len(recs),
        "并列展示未被选用记录，完整记录组仍冻结封存",
        "选用+未选用记录数与冻结完整记录组不符",
    )
    expect(all(a["shared_by"] == 2 for a in doc["record_attribution"]),
           "共享记录归属标注服务目标数", "共享归属标注异常")

    # 拒绝面：非通过来源、重复目标、越区、改换来源/目标指纹
    bad_src = verify({"audit_id": "ACC-BAD", "zone": ZONE, "target": "q.example.cn",
                      "salt": SALT, "iterations": ITER, "records": []})
    d = build_package("ACC-PKG-X", [PKG_T_DEEP, PKG_T_XY], bad_src)
    expect(d["verdict"] == "rejected" and "SOURCE_NOT_PASSED" in codes(d),
           "来源非通过结论明确拒绝", "非通过来源未被拒绝")
    d = build_package("ACC-PKG-X", [PKG_T_DEEP, PKG_T_DEEP], src)
    expect("DUP_TARGET" in codes(d), "重复目标明确拒绝", "重复目标未被拒绝")
    d = build_package("ACC-PKG-X", [PKG_T_DEEP, "x.other.net"], src)
    expect("OUT_OF_ZONE" in codes(d), "目标越区明确拒绝", "越区目标未被拒绝")

    # 既有单目标审计读取与复核保持原结果（不改写原审计）
    src_again = verify({"audit_id": "ACC-SRC", "zone": ZONE, "target": "q.example.cn",
                        "salt": SALT, "iterations": ITER, "records": recs})
    expect(
        src_again["verdict"] == src["verdict"] == "passed"
        and src_again["closest_encloser"]["hash"] == src["closest_encloser"]["hash"]
        and src_again["next_closer"]["hash"] == src["next_closer"]["hash"]
        and src_again["wildcard"]["hash"] == src["wildcard"]["hash"]
        and len(src["records"]) == len(recs),
        "既有单目标审计复核结果与原结论一致，原审计记录组未被改写",
        "既有单目标审计复核结果发生变化或原审计被改写",
    )


# ── 4/5. HTTP 冒烟 ───────────────────────────────────────────
def http(method, url, payload=None, timeout=6):
    data = None
    headers = {}
    if payload is not None:
        data = json.dumps(payload).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, resp.read().decode()
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read().decode()


def smoke(base_url, label):
    step("4/5", f"API/HTTP 冒烟（{label}：{base_url}）")
    status, body = http("GET", base_url + "/healthz")
    expect(status == 200 and '"ok"' in body,
           f"{label} 健康地址 /healthz 可访问",
           f"{label} 健康地址异常 status={status}")

    status, body = http("GET", base_url + "/")
    expect(status == 200 and "最近存在祖先" in body and "环绕方向" in body
           and "多目标共享证据包" in body and "共享记录归属" in body,
           f"{label} 审计页面可访问且含单目标并列证据栏与证据包区",
           f"{label} 审计页面异常 status={status}")

    recs = build_chain(DEFAULT_EXISTING)
    good = {"audit_id": f"HTTP-{label}", "zone": ZONE, "target": "q.example.cn",
            "salt": SALT, "iterations": ITER, "records": recs}
    status, body = http("POST", base_url + "/api/audits", good)
    expect(status == 200 and json.loads(body)["result"]["verdict"] == "passed",
           f"{label} 合法证明 POST 冻结成功",
           f"{label} 合法证明提交异常 status={status} body={body[:200]}")

    status, body = http("GET", base_url + f"/api/audits?id=HTTP-{label}")
    bj = json.loads(body)
    expect(status == 200 and bj["found"]
           and bj["result"]["closest_encloser"]["name"] == ZONE,
           f"{label} 按审计标识重新打开冻结结论成功",
           f"{label} 重开冻结结论异常 status={status}")

    truncated = [x for x in recs
                 if x["owner_hash"] != nsec3_hash("m.example.cn", SALT, ITER)]
    badp = dict(good, audit_id=f"HTTP-{label}-BAD", records=truncated)
    status, body = http("POST", base_url + "/api/audits", badp)
    expect(status == 422 and json.loads(body)["result"]["verdict"] == "rejected",
           f"{label} 遗漏通配符覆盖经 HTTP 被拒绝(422)",
           f"{label} 缺陷证据未被 HTTP 拒绝 status={status}")

    reuse = dict(good, target="zzz.example.cn")
    status, body = http("POST", base_url + "/api/audits", reuse)
    expect(status == 409 and json.loads(body).get("reuse") is True,
           f"{label} 标识复用但载荷改变返回 409 冲突",
           f"{label} 标识复用未被拦截 status={status}")

    # ── 多目标共享证据包 HTTP 冒烟 ──
    pkg = {"package_id": f"PKG-{label}", "source_audit_id": f"HTTP-{label}",
           "targets": [PKG_T_DEEP, PKG_T_XY]}
    status, body = http("POST", base_url + "/api/packages", pkg)
    bj = json.loads(body)
    expect(
        status == 200 and bj["result"]["verdict"] == "passed"
        and len(bj["result"]["selected_records"]) == 2,
        f"{label} 证据包抽取冻结成功且共同子集为 2 条",
        f"{label} 证据包抽取异常 status={status} body={body[:200]}",
    )

    status, body = http("GET", base_url + f"/api/packages?id=PKG-{label}")
    bj = json.loads(body)
    expect(status == 200 and bj["found"]
           and bj["result"]["targets"] == [PKG_T_DEEP, PKG_T_XY]
           and len(bj["result"]["target_evidence"]) == 2,
           f"{label} 按包标识重新打开冻结结论成功",
           f"{label} 证据包重开异常 status={status}")

    # 包标识改换目标 → 409，且原冻结结论不变
    pkg2 = dict(pkg, targets=[PKG_T_DEEP, "k.example.cn"])
    status, body = http("POST", base_url + "/api/packages", pkg2)
    expect(status == 409 and json.loads(body).get("reuse") is True,
           f"{label} 证据包标识改换来源/目标返回 409",
           f"{label} 证据包复用未被拦截 status={status}")

    # 非通过来源、重复/越区目标 → 422
    bad_src = dict(good, audit_id=f"HTTP-{label}-SRCB",
                   records=[x for x in recs
                            if x["owner_hash"] != nsec3_hash("m.example.cn", SALT, ITER)])
    http("POST", base_url + "/api/audits", bad_src)
    pkg3 = {"package_id": f"PKG-{label}-BADSRC",
            "source_audit_id": f"HTTP-{label}-SRCB", "targets": [PKG_T_DEEP, PKG_T_XY]}
    status, _ = http("POST", base_url + "/api/packages", pkg3)
    expect(status == 422, f"{label} 非通过来源被拒绝(422)",
           f"{label} 非通过来源未被拒绝 status={status}")
    pkg4 = {"package_id": f"PKG-{label}-DUP", "source_audit_id": f"HTTP-{label}",
            "targets": [PKG_T_DEEP, PKG_T_DEEP]}
    status, _ = http("POST", base_url + "/api/packages", pkg4)
    expect(status == 422, f"{label} 重复目标被拒绝(422)",
           f"{label} 重复目标未被拒绝 status={status}")

    # 抽取证据包后，来源单目标审计读取仍保持原结果
    status, body = http("GET", base_url + f"/api/audits?id=HTTP-{label}")
    bj = json.loads(body)
    expect(status == 200 and bj["result"]["target"] == "q.example.cn"
           and bj["result"]["verdict"] == "passed",
           f"{label} 证据包抽取后来源审计结论保持不变",
           f"{label} 来源审计被改写 status={status}")


def check_http():
    # 就地拉起一个临时服务做冒烟（自包含，无需外部依赖）
    os.environ.setdefault("AUDIT_DB", os.path.join(tempfile.mkdtemp(), "a.json"))
    from app.server import build_server
    httpd = build_server("127.0.0.1", 0)
    port = httpd.server_address[1]
    t = threading.Thread(target=httpd.serve_forever, daemon=True)
    t.start()
    time.sleep(0.2)
    try:
        smoke(f"http://127.0.0.1:{port}", "inproc")
    finally:
        httpd.shutdown()

    base_url = os.environ.get("BASE_URL")
    if base_url:
        # Compose 下等待 web 就绪后做远端冒烟
        for _ in range(30):
            try:
                status, _ = http("GET", base_url + "/healthz", timeout=2)
                if status == 200:
                    break
            except Exception:
                pass
            time.sleep(1)
        smoke(base_url.rstrip("/"), "compose-web")
    else:
        print("\n  （未设置 BASE_URL，跳过远端 Compose web 冒烟）")


def main():
    print(BOLD + "NSEC3 NXDOMAIN 审计服务 —— 一次性验收" + RESET, flush=True)
    check_build()
    check_unittests()
    check_scenarios()
    check_packages()
    check_http()

    print("\n" + "=" * 60)
    if _failures:
        print(f"{RED}{BOLD}验收失败：{len(_failures)} 项未通过{RESET}")
        for f in _failures:
            print(f"{RED}  - {f}{RESET}")
        sys.exit(1)
    print(f"{GREEN}{BOLD}验收通过：构建、测试、核心场景、API/HTTP 冒烟全部成功{RESET}")
    sys.exit(0)


if __name__ == "__main__":
    main()
